# מעתיקים ל-.env וממלאים. אסור להעלות את .env ל-git או לשתף אותו.

# טלגרם: הטוקן מ-@BotFather, וה-ID שלך מ-@userinfobot (כמה IDs מופרדים בפסיק)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# גוגל: ה-OAuth Client (Desktop app) של הפרויקט ב-Google Cloud
CLIENT_ID=
CLIENT_SECRET=

# המיקום למזג האוויר. חובה בשרת בענן - אחרת נלקח המיקום של חוות השרתים
AGENT_LATITUDE=32.0804
AGENT_LONGITUDE=34.7807
AGENT_CITY=Tel Aviv

# שעת הודעת הבוקר (שעון ישראל)
DAILY_TIME=07:00

# כמה ימים טוקן של גוגל תקף אחרי האישור - 7 כל עוד האפליקציה במצב Testing.
# הבוט מזכיר לחדש יום לפני. 0 = לא להזכיר (אחרי מעבר ל-In production).
GOOGLE_TOKEN_MAX_AGE_DAYS=7

# אופציונלי: יומן גוגל נפרד לאימונים (אחרת - היומן הראשי, רק אירועים עם [A]/[B]/[RUN])
# WORKOUT_CALENDAR_ID=
