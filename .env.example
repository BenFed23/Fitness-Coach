# Copy to .env and fill in. Never commit .env to git or share it.

# Telegram: the token from @BotFather, and your ID from @userinfobot (several IDs separated by commas)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Google: the project's OAuth client (Desktop app) in Google Cloud
CLIENT_ID=
CLIENT_SECRET=

# Location for the weather. Required on a cloud server - otherwise the data center's location is used
AGENT_LATITUDE=32.0804
AGENT_LONGITUDE=34.7807
AGENT_CITY=Tel Aviv

# Time of the morning message (Israel time)
DAILY_TIME=07:00

# How many days a Google token stays valid after approval - 7 while the app is in Testing.
# The bot reminds you a day before. 0 = no reminders (after moving to In production).
GOOGLE_TOKEN_MAX_AGE_DAYS=7

# Optional: a separate Google calendar for workouts (otherwise the primary calendar,
# where only titles starting with [A]/[B]/[RUN] or Workout/Run count)
# WORKOUT_CALENDAR_ID=
